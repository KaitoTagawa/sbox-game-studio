@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	<div class="hud-corner">
		<div class="stat-pill calendar">
			<div class="pill-icon cal-icon">📅</div>
			<div class="cal-day">@Day</div>
			<div class="cal-month">@MonthShort</div>
			<div class="cal-year">@Year</div>
		</div>
		<div class="stat-pill money">
			<div class="pill-icon money-icon">$</div>
			<div class="pill-value">@DisplayMoney</div>
		</div>
		<div class="stat-pill energy">
			<div class="pill-icon energy-icon">⚡</div>
			<div class="pill-value">@Energy</div>
		</div>
	</div>

	@* Top-right column. Progress widget sits above the notification stack so
	   toasts always slide in below the in-flight project. *@
	<div class="hud-right">
		@if ( ShowProgress )
		{
			@* Single combined bar — all three pillars advance at the same rate
			   post-2026-04-29 rework. Score is broken down per category with an
			   icon. Mirrors the create-game modal's production-view card. *@
			<div class="hud-progress">
				<div class="prog-head">
					<div class="prog-title">@ProjectTitle</div>
					<div class="prog-pct @(IsFinished ? "ready" : "")">@(IsFinished ? "READY TO SHIP" : $"{OverallPct}%")</div>
				</div>
				<div class="prog-bar">
					<div class="prog-fill" style="@WidthStyle( OverallProgress )"></div>
				</div>
				<div class="prog-pts-row">
					<div class="prog-pts-cell">
						<div class="prog-pts-icon">🎮</div>
						<div class="prog-pts-num">@(Project?.DesignPoints ?? 0)</div>
					</div>
					<div class="prog-pts-cell">
						<div class="prog-pts-icon">🎵</div>
						<div class="prog-pts-num">@(Project?.SoundPoints ?? 0)</div>
					</div>
					<div class="prog-pts-cell">
						<div class="prog-pts-icon">🎨</div>
						<div class="prog-pts-num">@(Project?.GraphicsPoints ?? 0)</div>
					</div>
				</div>
			</div>
		}

		@* Hud renders info / success / danger toasts in one stack so the
		   "Frustrated" red toast appears next to the "Idea!" blue toast.
		   Only "warning" still routes through NotificationsOverlay (ZIndex
		   1000) so genuinely-blocking failure messages pop on top of any
		   open menu. Filter mirrors NotificationsOverlay's. *@
		<div class="hud-notifications">
			@foreach ( var toast in Toasts )
			{
				if ( toast.Kind == "warning" ) continue;
				var t = toast;
				<div class="toast toast-@t.Kind">
					<div class="toast-title">@t.Title</div>
					<div class="toast-text">@t.Body</div>
				</div>
			}
		</div>
	</div>

	@* Center-screen interact prompt — only visible when an employee is in
	   range, no modal is open, and the player isn't already chatting
	   (EmployeeInteractor handles the gating). *@
	@if ( InteractTargetName is { } targetName )
	{
		<div class="interact-prompt">
			<div class="interact-key">E</div>
			<div class="interact-text">Talk to @targetName</div>
		</div>
	}

	@* Bottom-of-screen chat panel — visible while EmployeeInteractor.IsChatting.
	   The cursor is unlocked while this is open (GameManager treats it as a
	   modal), so reply buttons receive clicks normally. *@
	@if ( ChatTarget is { } target )
	{
		<div class="chat-panel">
			<div class="chat-header">
				<div class="chat-name">@target.EmployeeName</div>
				<div class="chat-role">@RoleLabel( target.Role )</div>
				<div class="chat-close" onclick=@CloseChat>×</div>
			</div>
			<div class="chat-line">@ChatLine</div>
			@* Reply list — driven by EmployeeInteractor.Instance.ReplyOptions
			   so the keyboard-nav handler and the Razor button list stay in
			   sync. ReplyOptions is now an instance getter (not static)
			   because the set is mood-dependent — Good mood swaps in
			   Accept / Maybe later for the default chat replies. *@
			<div class="chat-replies">
				@{ var replies = EmployeeInteractor.Instance?.ReplyOptions; }
				@if ( replies is not null )
				{
					@for ( int i = 0; i < replies.Count; i++ )
					{
						var idx     = i;
						var option  = replies[idx];
						var classes = idx == ChatSelectedIndex ? "chat-reply selected" : "chat-reply";
						<div class="@classes" onclick=@(() => ClickReply(idx))>@option.Label</div>
					}
				}
			</div>
		</div>
	}
</root>

@code {
	private long   Money      => GameManager.Instance?.Money      ?? 0;
	private int    Energy     => GameManager.Instance?.Energy     ?? 0;
	private int    Day        => GameManager.Instance?.Day        ?? 1;
	private int    Month      => GameManager.Instance?.Month      ?? 1;
	private int    Year       => GameManager.Instance?.Year       ?? 1;
	private string MonthShort => GameManager.Instance?.MonthShort ?? "Jan";

	private string DisplayMoney => Money.ToString( "N0" );

	private IReadOnlyList<Notifications.Toast> Toasts => Notifications.Active;

	/// Name of the NPC currently in interaction range, or null when no
	/// employee is greetable OR the player is already chatting (the chat
	/// panel makes the prompt redundant). Drives the centered prompt.
	private string InteractTargetName
	{
		get
		{
			var ix = EmployeeInteractor.Instance;
			if ( ix is null || ix.IsChatting ) return null;
			return ix.NearestEmployee?.EmployeeName;
		}
	}

	// ── Chat panel state — read-through to EmployeeInteractor ─────────────────

	private EmployeeNPC ChatTarget         => EmployeeInteractor.Instance?.ChatTarget;
	private string      ChatLine           => EmployeeInteractor.Instance?.ChatLine;
	private int         ChatSelectedIndex  => EmployeeInteractor.Instance?.SelectedReplyIndex ?? 0;

	/// Click handler for a reply tile — also moves the keyboard selection
	/// to the clicked index, then runs that reply's action (NPC response
	/// for chat options, panel close for the exit entry).
	private void ClickReply( int index )
	{
		var ix = EmployeeInteractor.Instance;
		if ( ix is null ) return;
		ix.SelectReply( index );
		ix.ConfirmSelected();
	}

	private void CloseChat()
	{
		EmployeeInteractor.Instance?.CloseChat();
	}

	private static string RoleLabel( EmployeeRole role ) => role switch
	{
		EmployeeRole.Programmer    => "PROGRAMMER",
		EmployeeRole.Designer      => "DESIGNER",
		EmployeeRole.Creative      => "CREATIVE",
		EmployeeRole.Artist        => "ARTIST",
		EmployeeRole.SoundDesigner => "SOUND",
		EmployeeRole.Researcher    => "RESEARCH",
		EmployeeRole.Founder       => "FOUNDER",
		_                          => "",
	};

	// ── In-flight project widget ─────────────────────────────────────────────
	// Shown only while a project is actually in Production. Setup phase is
	// hidden behind the modal anyway, and Finished is handled by Step 5d.

	private GameProject Project => GameProjectManager.Instance?.Current;

	/// Widget appears for both Production (live progress) and Finished
	/// (the "READY TO SHIP" state) so the HUD acts as a one-click way back
	/// into the publish modal. Hides while any modal is open.
	private bool ShowProgress =>
		Project is not null &&
		(Project.Phase == GameProjectPhase.Production
		 || Project.Phase == GameProjectPhase.Finished) &&
		!(GameProjectManager.Instance?.IsOpen ?? false);

	private bool IsFinished =>
		Project is not null && Project.Phase == GameProjectPhase.Finished;

	private string ProjectTitle =>
		string.IsNullOrWhiteSpace( Project?.Title ) ? "Untitled Project" : Project.Title;

	/// All active pillars advance at the same rate, so we just read the first
	/// pillar with non-zero effort. Sacrificed pillars sit at 1.0 from
	/// BeginProduction onward — averaging them in would falsely lift the
	/// readout at t=0. Same logic as <c>CreateGamePanel.OverallProgress</c>.
	private float OverallProgress
	{
		get
		{
			if ( Project is null )                  return 0f;
			if ( Project.DesignTime   > 0f )        return Project.DesignProgress;
			if ( Project.SoundTime    > 0f )        return Project.SoundProgress;
			if ( Project.GraphicsTime > 0f )        return Project.GraphicsProgress;
			return 1f;
		}
	}

	private int OverallPct => (int)MathF.Round( OverallProgress * 100f );

	/// Total quality points across all three pillars. Drives the HUD
	/// widget's score readout — same value the in-modal production view
	/// shows as its headline.
	private int TotalPoints =>
		(Project?.DesignPoints ?? 0)
		+ (Project?.SoundPoints ?? 0)
		+ (Project?.GraphicsPoints ?? 0);

	/// Inline `width:%` string for a progress fill. Same pattern the create-
	/// game panel uses — keeps the Razor expression dead simple.
	private static string WidthStyle( float fraction ) =>
		$"width: {fraction * 100f:0.##}%;";

	// Re-render whenever toast list changes too. Count + first ShownAt is a cheap proxy.
	protected override int BuildHash() =>
		System.HashCode.Combine(
			System.HashCode.Combine(
				Money, Energy, Day, Month, Year,
				Toasts.Count,
				Toasts.Count > 0 ? Toasts[0].ShownAt : 0f ),
			ShowProgress,
			GameProjectManager.Instance?.IsOpen ?? false,
			ProjectTitle,
			// Quantise progress to ~1 % so the bar redraws smoothly without
			// burst-rebuilding every frame; pts ticks on its own integer cadence.
			(int)(OverallProgress * 100f),
			TotalPoints,
			IsFinished,
			System.HashCode.Combine(
				InteractTargetName,
				ChatTarget?.EmployeeName,
				ChatLine,
				ChatSelectedIndex ) );
}
