@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

@* Menu is now purely a launcher of fullscreen modals (ADR-0003 Phase 1).
   Every tile routes to its own modal via GameMenu.Activate; this panel
   just renders the tile grid + handles open/close + tutorial gating. *@

<root class="@(IsOpen ? "open" : "closed")">
	<div class="backdrop" onclick=@Close></div>
	<div class="window">
		<div class="header">
			<div class="title">@HeaderText</div>
			<div class="close-btn" onclick=@Close>×</div>
		</div>

		<div class="grid">
			@for ( var i = 0; i < Tiles.Count; i++ )
			{
				var index = i;
				var tile  = Tiles[i];
				var disabled = !TileEnabled( tile.Name );
				<div class="tile tile-@index @(HoveredIndex == index ? "hover" : "") @(disabled ? "disabled" : "")"
					 onmouseover=@(() => Hover( index ))
					 onmouseout=@Unhover
					 onclick=@(() => Activate( index ))>
					@if ( !string.IsNullOrEmpty( tile.Icon ) )
					{
						<div class="tile-icon">@tile.Icon</div>
					}
					<div class="tile-label">@tile.Name</div>
				</div>
			}
		</div>
	</div>
</root>

@code {
	// ── State pulled from GameMenu ───────────────────────────────────────────

	private bool IsOpen                       => GameMenu.Instance?.IsOpen          ?? false;
	private IReadOnlyList<MenuTile> Tiles     => GameMenu.Instance?.Tiles           ?? System.Array.Empty<MenuTile>();
	private int  HoveredIndex                 => GameMenu.Instance?.HoveredIndex    ?? -1;

	// ── Header ───────────────────────────────────────────────────────────────

	private string HeaderText
	{
		get
		{
			if ( HoveredIndex < 0 || HoveredIndex >= Tiles.Count )
				return "MENU";
			return Tiles[HoveredIndex].Name.ToUpper();
		}
	}

	// ── Tile interactions ────────────────────────────────────────────────────

	private void Hover( int index )       { if ( GameMenu.Instance is { } m ) m.HoveredIndex = index; }
	private void Unhover()                { if ( GameMenu.Instance is { } m ) m.HoveredIndex = -1; }
	private void Activate( int index )    => GameMenu.Instance?.Activate( index );
	private void Close()                  => GameMenu.Instance?.SetOpen( false );

	/// Tile-name → enabled. Routes through TutorialManager during the
	/// first-launch flow; outside the tutorial every tile is enabled.
	private bool TileEnabled( string tileName ) =>
		TutorialManager.Instance?.IsTileEnabled( tileName ) ?? true;

	// ── Re-render trigger ────────────────────────────────────────────────────

	protected override int BuildHash()
	{
		return System.HashCode.Combine(
			IsOpen, HoveredIndex,
			Achievements.Unlocked.Count,
			// Tutorial phase drives .disabled classes on every tile —
			// without it, the menu wouldn't redraw when Begin is clicked or
			// the first hire lands.
			(int)(TutorialManager.Instance?.Phase ?? TutorialPhase.Complete) );
	}
}
